from kivy.uix.screenmanager import Screen
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.button import Button
from kivy.uix.label import Label

class HomeScreen(Screen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', spacing=20, padding=50)
        
        titulo = Label(text='NFE Scanner', font_size=32, size_hint_y=0.3)
        
        btn_scan = Button(text='📷 Escanear Nota', size_hint_y=0.2)
        btn_scan.bind(on_press=self.go_to_scan)
        
        btn_list = Button(text='📋 Notas Escaneadas', size_hint_y=0.2)
        btn_list.bind(on_press=self.go_to_list)
        
        btn_report = Button(text='📊 Relatórios', size_hint_y=0.2)
        btn_report.bind(on_press=self.go_to_report)
        
        layout.add_widget(titulo)
        layout.add_widget(btn_scan)
        layout.add_widget(btn_list)
        layout.add_widget(btn_report)
        
        self.add_widget(layout)
    
    def go_to_scan(self, instance):
        self.manager.current = 'scan'
    
    def go_to_list(self, instance):
        self.manager.current = 'list'
    
    def go_to_report(self, instance):
        self.manager.current = 'report'